# Copy this file to .env. The backend loads .env automatically on startup.
AI_PROVIDER=local
AI_PROVIDER_TIMEOUT_SECONDS=60

# OpenAI-compatible default provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.3

# DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.3

BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=
